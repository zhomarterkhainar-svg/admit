{
  "name": "qozgal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QOZĞAL — AI-тренер «Путь Батыра»: управление телом через веб-камеру, подсчёт повторений и режим «ошибка»",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/fetch-models.mjs",
    "train": "vitest run tests/train.test.ts --mode train",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
